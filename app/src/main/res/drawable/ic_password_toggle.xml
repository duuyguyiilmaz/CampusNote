<?xml version="1.0" encoding="utf-8"?>
<!--
    Şifre görünürlük düğmesinin ikonu.

    Material'in varsayılanı *eylemi* gösterir: şifre gizliyken açık göz ("göstermek
    için bas"). Bu uygulama *durumu* gösteriyor — gizliyken üstü çizili göz, görünürken
    açık göz — çünkü kullanıcılar ikonu "şu an ne olduğu" olarak okuyor.

    `state_checked`, TextInputLayout'un password_toggle end icon'unda "şifre görünür"
    demek; işaretsiz hâli gizli şifredir.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:drawable="@drawable/ic_visibility"/>
    <item android:drawable="@drawable/ic_visibility_off"/>
</selector>
