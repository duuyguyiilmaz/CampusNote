rules_version = '2';

// CampusNote Firestore güvenlik kuralları.
//
// Kurallar bilinçli olarak repoda tutuluyor: Firebase Console'daki kurallar
// gözden geçirilemez ve sürüm geçmişi tutulmaz. Yayına almak için:
//
//     firebase deploy --only firestore:rules
//
// Puanlama hâlâ istemcide hesaplanıyor — Cloud Functions faturalandırmalı Blaze
// planı istiyor, proje ücretsiz planda. Ama "istemci hesaplıyor" ile "istemciye
// güveniliyor" aynı şey değil: notun yeni `ratingSum`/`ratingCount` değerleri
// aşağıda, aynı commit'te yazılan oy dokümanından yeniden hesaplanıp
// karşılaştırılıyor. İstemci sonucu üretiyor, sunucu doğruluyor.
//
// Ortalama puan artık hiç saklanmıyor. Saklandığı sürece kurallar onu tam olarak
// doğrulayamıyordu — kural dili tam sayı bölmesi yaptığı için `avgRating` yalnızca
// 0–5 aralığında bir sayı olmakla sınırlanabiliyordu, yani geçerli bir oyla
// birlikte uydurma bir ortalama yazılabiliyordu. Alan kaldırıldı: gösterilen değer
// artık `ratingSum`'ın kendisi, o da oy dokümanından birebir doğrulanıyor.
// Doğrulanamayan bir alanı tutmaktansa tutmamak.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Bu yazma işleminde gerçekten değişen alanlar.
    function changedFields() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    match /users/{userId} {
      /**
       * Profil yalnızca sahibine açık.
       *
       * Buradaki eski yorum "liderlik tablosu ve profil ekranı diğer kullanıcıları
       * da okuyabilmeli" diyordu; doğru değildi. Uygulamadaki dört `getUser`
       * çağrısının dördü de oturumdaki kullanıcının kendi uid'ini geçiyor — sıralama
       * ve not detayı yükleyenin adını notun kendi alanından alıyor, profilden
       * değil. Herkese açık okuma, kimsenin ihtiyaç duymadığı bir izindi: oturum
       * açmış biri bütün öğrencilerin e-postasını ve bölümünü tek sorguda
       * indirebiliyordu.
       */
      allow read: if isOwner(userId);

      // Kayıt sırasında kullanıcı yalnızca kendi dokümanını oluşturabilir.
      allow create: if isOwner(userId)
                    && request.resource.data.id == userId;

      // Uygulama bu dokümanı yalnızca oluşturuyor, hiç güncellemiyor
      // (`saveUser` tek çağrısı kayıt akışında). Açık bırakmanın bedeli vardı:
      // `points` burada saklandığı sürece kurallar hem sahibinin kendi puanını
      // yazmasına hem de bir kullanıcının başkasının puanını değiştirmesine izin
      // vermek zorundaydı. Puan artık saklanmıyor, notların `ratingSum`
      // toplamından türetiliyor; dolayısıyla güncellemeye hiç gerek kalmadı.
      // İleride profil düzenleme eklenirse kendi dar kuralını da getirmeli.
      allow update: if false;

      // Hesap silme uygulamada yok; kaza ile veri kaybını engelle.
      allow delete: if false;
    }

    match /notes/{noteId} {
      /**
       * Notlar yalnızca kendi bölümüne açık.
       *
       * Arayüzün her sorguyu `department`'a filtrelemesi bir sınır değildi:
       * Firestore'a doğrudan bağlanan bir istemci filtreyi kaldırıp bütün
       * üniversitenin notlarını indirebiliyordu.
       *
       * Firestore liste sorgularında kuralı dönen belgelere değil *sorgunun kendisine*
       * uyguluyor: sorgu, sonuçların kuralı sağlayacağını garanti eden bir filtre
       * taşımıyorsa hiç çalıştırılmadan reddediliyor. Yani feed'in
       * `where department == X` filtresi artık isteğe bağlı bir nezaket değil,
       * sorgunun geçme koşulu.
       *
       * `uploaderUid` dalı bu yüzden var, gevşeklikten değil: katkı kapısı ve profil
       * ekranı `where uploaderUid == ben` sorguluyor ve bölüm filtresi taşımıyor.
       * Tek dallı bir kural o sorguları — kullanıcının kendi notları olmasına
       * rağmen — reddediyordu; canlıda feed boş açıldı, kapı hiç değerlendirilemedi.
       * İki dal, uygulamanın gerçekten kurduğu iki sorguya karşılık geliyor;
       * filtresiz bir sorgu ikisini de sağlamadığı için hâlâ reddediliyor.
       */
      allow read: if isSignedIn() && (
                    resource.data.department == ownDepartment()
                    || resource.data.uploaderUid == request.auth.uid
                  );

      /**
       * Not oluşturma.
       *
       * Buradaki kontroller uygulamadaki form doğrulamasının kopyası değil, onun
       * yerine geçeni: Android arayüzü saldırganın kullanmak zorunda olduğu tek yol
       * değil, Firestore'a doğrudan bağlanan bir istemci hangi alanı isterse yazar.
       * Eskiden yalnızca `uploaderUid` ile puan alanlarına bakılıyordu; geri kalan
       * her şey — bölüm adı, yükleyenin e-postası, hiç beklenmeyen alanlar —
       * serbestti.
       *
       * Alan kümesi `hasOnly` + `hasAll` ile birebir sabitleniyor: eksik alan da
       * fazlası da reddediliyor. Bu, artık yazılmayan `avgRating`'i de kapatıyor —
       * ortalama saklanmıyor, dolayısıyla uydurulamıyor da.
       */
      allow create: if isSignedIn()
                    && hasExactNoteFields()
                    && hasValidNoteTypes()
                    // Kimlik istemciden değil, oturumdan geliyor.
                    && request.resource.data.uploaderUid == request.auth.uid
                    // Nota e-posta hiç yazılmıyor: gösterilen ad doğrudan
                    // saklanıyor. Arayüzde kırpmak dokümandaki adresi gizlemiyordu
                    // — aynı bölümdeki herkes ham `uploaderEmail`'i okuyabiliyordu.
                    && request.resource.data.uploaderName == ownDisplayName()
                    // Not, yazarın kendi bölümüne düşmek zorunda: aksi halde biri
                    // başka bölümün feed'ine içerik sokabilirdi. Bölümü boş kalmış
                    // eski bir profil bu yüzden hiç yükleyemez — uygulamadaki
                    // `UNKNOWN_DEPARTMENT` yedeği artık yazma yolunda geçmiyor.
                    // Kayıt bölüm seçmeden tamamlanamadığı için bu yalnızca bozuk
                    // veriyi kapsıyor, ve o notu zaten hiçbir feed göstermiyordu.
                    && request.resource.data.department == ownDepartment()
                    // Sunucu saati; istemci notu geçmişe ya da geleceğe tarihleyemez.
                    && request.resource.data.createdAt == request.time
                    // Puanı sıfırdan başlatmak zorunda: aksi halde nota doğrudan
                    // yüksek puanla doğulurdu.
                    && request.resource.data.ratingSum == 0
                    && request.resource.data.ratingCount == 0;

      function noteFields() {
        return [
          'course', 'title', 'description', 'tag', 'department',
          'uploaderUid', 'uploaderName', 'createdAt',
          'ratingSum', 'ratingCount',
          'fileName', 'fileType', 'fileSize'
        ];
      }

      function hasExactNoteFields() {
        return request.resource.data.keys().hasOnly(noteFields())
               && request.resource.data.keys().hasAll(noteFields());
      }

      /**
       * Tip ve boyut kontrolleri. Uzunluk sınırları arayüzdekilerle aynı olmak
       * zorunda değil — buradaki iş bir dokümanın feed'i bozacak kadar büyümesini
       * ya da sayı beklenen yere metin yazılmasını engellemek.
       */
      function hasValidNoteTypes() {
        let data = request.resource.data;
        return data.course is string && data.course.size() > 0 && data.course.size() <= 100
               && data.title is string && data.title.size() > 0 && data.title.size() <= 200
               && data.description is string && data.description.size() <= 2000
               && data.tag is string && data.tag.size() <= 50
               && data.department is string
               && data.uploaderUid is string
               && data.uploaderName is string && data.uploaderName.size() <= 64
               && data.createdAt is timestamp
               && data.ratingSum is int
               && data.ratingCount is int
               && data.fileName is string && data.fileName.size() <= 260
               && data.fileType in ['pdf', 'image', '']
               && data.fileSize is int && data.fileSize >= 0;
      }

      /**
       * Çağıranın kendi profilindeki bölüm; istemcinin gönderdiği değil.
       *
       * Profili olmayan bir hesapta `get()` null döner ve erişim değerlendirme
       * hatasına düşer — yani kapalı kalır, ki doğrusu bu.
       */
      function ownDepartment() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid))
                 .data.department;
      }

      /**
       * Oturumdaki e-postanın `@` öncesi kısmı — nota yazılabilecek tek ad.
       *
       * Adın oturumdan türetilmesi, birinin başkasının adıyla not paylaşmasını
       * engelliyor; e-postanın kendisi hiçbir yere yazılmıyor.
       */
      function ownDisplayName() {
        return request.auth.token.email.split('@')[0];
      }

      /** Dosya içeriği kuralı için üst notun bölümü. */
      function noteDepartment(noteId) {
        return get(/databases/$(database)/documents/notes/$(noteId))
                 .data.department;
      }

      allow update: if isSignedIn() && (
                      isMetadataEditByOwner()
                      || isRatingWrite(noteId)
                    );

      // Sahibi metadata'yı düzenleyebilir ama puan alanlarına, sahiplik bilgisine
      // ve bölüme dokunamaz — kendi notunu öne çıkarmanın en kısa yolu buydu.
      // `avgRating` listede: alan artık yazılmıyor, düzenlemeyle geri gelmesin.
      function isMetadataEditByOwner() {
        return resource.data.uploaderUid == request.auth.uid
               && !changedFields().hasAny([
                    'ratingSum', 'ratingCount', 'avgRating',
                    'uploaderUid', 'uploaderName', 'uploaderEmail',
                    'department', 'createdAt'
                  ]);
      }

      function ratingPath(noteId) {
        return /databases/$(database)/documents/ratings/$(request.auth.uid + '_' + noteId);
      }

      /**
       * Oyu veren kişinin yazabileceği tek değişiklik.
       *
       * `getAfter` aynı commit'in *sonrasındaki* oy dokümanını okur; oy dokümanı
       * yazılmadan notun toplamı değiştirilemez. Beklenen toplamlar
       * RatingCalculator ile birebir aynı hesaplanıyor — tabanları dahil, çünkü
       * istemci de aynı tabanları uyguluyor ve eşitlik tutmak zorunda.
       *
       * `math.max` kurallarda yok, o yüzden tabanlar üçlü işleçle yazıldı.
       */
      function isRatingWrite(noteId) {
        let path = ratingPath(noteId);
        let votedBefore = exists(path);
        let previous = votedBefore ? get(path).data.rating : 0;
        let submitted = getAfter(path).data;
        let rawSum = resource.data.ratingSum + submitted.rating - previous;

        return changedFields().hasOnly(['ratingSum', 'ratingCount'])
               // Kendi notuna oy vermek burada yasaklanıyor; eskiden yalnızca
               // istemci kodunda kontrol ediliyordu.
               && resource.data.uploaderUid != request.auth.uid
               && submitted.noteId == noteId
               && request.resource.data.ratingSum == (rawSum < 0 ? 0 : rawSum)
               // Oy değiştirildiğinde sayı artmaz.
               && request.resource.data.ratingCount == (
                    votedBefore
                      ? (resource.data.ratingCount < 1 ? 1 : resource.data.ratingCount)
                      : resource.data.ratingCount + 1
                  );
      }

      // Uygulama kodu silme öncesi sahiplik kontrolü YAPMIYOR; tek gerçek
      // engel bu kural. (NoteRepository.deleteNote doğrudan siliyor, arayüz
      // sadece kendi notlarında silme düğmesini gösteriyor.)
      allow delete: if isSignedIn()
                    && resource.data.uploaderUid == request.auth.uid;

      // Dosya içeriği ayrı dokümanda: feed sorguları base64 veriyi indirmesin.
      match /content/{contentId} {
        // Dosya, bağlı olduğu notla aynı kapsamda: notu okuyamayan içeriğini de
        // okuyamamalı, aksi halde bölüm sınırı dosya yolundan atlanırdı.
        allow read: if isSignedIn() && noteDepartment(noteId) == ownDepartment();

        // Not ile içerik aynı batch'te yazılıyor. Batch içindeki her yazma
        // ayrı değerlendirilir ve get() henüz commit edilmemiş üst dokümanı
        // göremez — bu yüzden create'te sahiplik doğrulanamaz.
        allow create: if isSignedIn();

        allow update, delete: if isSignedIn()
          && get(/databases/$(database)/documents/notes/$(noteId))
               .data.uploaderUid == request.auth.uid;
      }
    }

    match /ratings/{ratingId} {
      allow read: if isSignedIn();

      // Doküman kimliği "<oyVerenUid>_<notId>" biçiminde; bu kalıbı zorunlu
      // kılmak bir kullanıcının başkasının oyunu yazmasını engelliyor.
      allow create, update: if isSignedIn()
                            && request.resource.data.uid == request.auth.uid
                            && ratingId == request.auth.uid + '_' + request.resource.data.noteId
                            && request.resource.data.rating is int
                            && request.resource.data.rating >= 1
                            && request.resource.data.rating <= 5
                            // Kendi notuna oy veren bir kayıt hiç oluşmasın:
                            // notun toplamını değiştirmese de liderlik tablosunun
                            // oy sayısını şişirirdi.
                            && get(/databases/$(database)/documents/notes/$(request.resource.data.noteId))
                                 .data.uploaderUid != request.auth.uid;

      allow delete: if false;
    }

    // Yukarıda eşleşmeyen her yol reddedilir. Yeni bir koleksiyon eklendiğinde
    // kuralı da yazılana kadar kapalı kalır — açık kalmasındansa erişilemez olması.
  }
}
